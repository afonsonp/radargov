#!/usr/bin/env bash
# O portao da release, automatico: corre quando se empurra uma TAG.
#
# 19/09/2026, a pedido dele -- "quero que seja automatico essa revisao
# de documentos antes do push". Ate aqui o
# `ferramentas/antes_da_release.py` existia e alguem tinha de se
# lembrar de o correr, que e exactamente o problema que ele resolve.
#
# **So nas tags**: um push de master nao e uma release, e o commit ja
# tem o seu portao (`testes_antes_do_commit.py`, e o validador da
# documentacao dentro da bateria); aqui trata-se so do que e novo numa
# release. Ate 23/09/2026 era tambem obrigatorio, porque o
# `empurrar_triagem()` empurrava sozinho.
#
# O git passa em cada linha do stdin:
#   <ref local> <sha local> <ref remota> <sha remoto>
# Uma tag vem como `refs/tags/v1.8.6`.
#
# Para saltar o portao uma vez -- numa emergencia --, `--no-verify`.

set -u
RAIZ="$(git rev-parse --show-toplevel)"
PYTHON="$RAIZ/.venv/bin/python"
[ -x "$PYTHON" ] || PYTHON="$(command -v python3 || command -v python)"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/tags/v*)
      versao="${remote_ref#refs/tags/}"
      echo
      echo " ── O portão da release, antes de empurrar a $versao ──"
      echo
      if ! "$PYTHON" "$RAIZ/ferramentas/antes_da_release.py" "$versao"; then
        echo
        echo " A tag $versao NÃO foi empurrada."
        echo " Resolve o que está acima, ou usa --no-verify se souberes"
        echo " porque é que o portão está errado."
        exit 1
      fi
      ;;
  esac
done

exit 0
